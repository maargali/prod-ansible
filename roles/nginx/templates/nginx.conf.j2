events {}

http {

    include /etc/nginx/mime.types;

{% for vhost in nginx_vhosts %}

server {
    listen 80;
    listen [::]:80;

    server_name {{ vhost.server_names | join(' ') }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {

    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name {{ vhost.server_names | join(' ') }};

    ssl_certificate /etc/letsencrypt/live/{{ vhost.cert_name | default(vhost.primary_domain) }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ vhost.cert_name | default(vhost.primary_domain) }}/privkey.pem;
{% for location in vhost.nginx_locations %}

    location {{ location.path }} {

        proxy_pass {{ location.proxy_pass }};

        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        resolver 127.0.0.11 ipv6=off valid=30s;
    }

{% endfor %}
}

{% endfor %}
}
